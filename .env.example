# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Backend port
PORT=5000

# Optional shared secret: if set, the PC daemon poll endpoint requires it
# (?token=... or X-Daemon-Token header)
DAEMON_TOKEN=

# Remote API access: when set, ALL /api routes (except /health) require it
# via `x-api-key` header or `?api_key=` query param. This is the key your
# AI assistant uses to read/control projects remotely. Generate something long:
#   openssl rand -hex 32
API_KEY=

# Optional: raises the GitHub API rate limit from 60 to 5000 req/hr
# (fine-grained token, no scopes needed for public repos)
GITHUB_TOKEN=
