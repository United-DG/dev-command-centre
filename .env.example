# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here / channel_id

# Backend port
PORT=5000

# Optional shared secret: if set, the PC daemon and the settings/test
# endpoints require it (?token=... or X-Daemon-Token header)
DAEMON_TOKEN=

# Optional: raises the GitHub API rate limit from 60 to 5000 req/hr
# (fine-grained token, no scopes needed for public repos)
GITHUB_TOKEN=
